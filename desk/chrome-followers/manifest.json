{
  "manifest_version": 3,
  "name": "Desk Followers",
  "version": "1.1.0",
  "description": "Lists the people who do not follow back. One press of yours unfollows that one person.",
  "key": "",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Desk Followers"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:4747/*",
    "https://www.instagram.com/*"
  ],
  "commands": {
    "done": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "Unfollow the first person in the list"
    },
    "keep": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "Keep this person"
    },
    "later": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Decide later"
    },
    "undo": {
      "suggested_key": {
        "default": "Alt+Z"
      },
      "description": "Back to the last person (the list only)"
    }
  },
  "incognito": "not_allowed"
}
