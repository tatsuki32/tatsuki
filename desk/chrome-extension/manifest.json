{
  "manifest_version": 3,
  "name": "Tatsuki's Desk Web履歴",
  "version": "1.0.0",
  "description": "前面のタブを見ていた時間を測り、この Mac の Desk だけに送ります。",
  "key": "",
  "background": {"service_worker": "background.js"},
  "permissions": ["tabs", "idle", "alarms", "storage"],
  "host_permissions": ["http://localhost:4747/*"],
  "incognito": "not_allowed"
}
